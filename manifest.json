{
  "manifest_version": 3,
  "name": "Time Tracking URL Monitor",
  "version": "1.0.0",
  "description": "Captures browser URLs for accurate time tracking and productivity monitoring",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*",
    "http://127.0.0.1:8771/*",
    "http://127.0.0.1:8772/*",
    "http://127.0.0.1:8773/*",
    "http://127.0.0.1:8774/*",
    "http://127.0.0.1:8775/*",
    "ws://127.0.0.1:8765/*",
    "ws://127.0.0.1:8766/*",
    "ws://127.0.0.1:8767/*",
    "ws://127.0.0.1:8768/*",
    "ws://127.0.0.1:8769/*",
    "ws://127.0.0.1:8770/*",
    "ws://127.0.0.1:8771/*",
    "ws://127.0.0.1:8772/*",
    "ws://127.0.0.1:8773/*",
    "ws://127.0.0.1:8774/*",
    "ws://127.0.0.1:8775/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
